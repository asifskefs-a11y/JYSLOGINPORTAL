<?xml version="1.0" encoding="utf-8"?>
<!-- Hardened: HTTPS only, system CAs only (the old file allowed plain HTTP and user-installed
     certificates, which makes man-in-the-middle attacks possible). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Local testing only (emulator / localhost). Remove for release builds if you don't need it. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
